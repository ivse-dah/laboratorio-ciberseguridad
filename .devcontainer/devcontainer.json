{
  "name": "Kali Linux Oficial en el Navegador",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postStartCommand": "nohup sh -c 'vncserver :1 -geometry 1280x720 -depth 24 && websockify --web /usr/share/novnc/ 6080 localhost:5901' > /tmp/vnc.log 2>&1 &",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Kali Linux Escritorio",
      "visibility": "public",
      "onAutoForward": "openBrowser"
    }
  }
}
