{
  "name": "Laboratorio Ciberseguridad Kali",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--device=/dev/net/tun"
  ],
  "postStartCommand": "vncserver -kill :1 2>/dev/null; vncserver :1 -geometry 1280x720 -depth 24 && websockify -D --web /usr/share/novnc/ 6080 localhost:5901"
}
