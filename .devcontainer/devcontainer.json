{
  "name": "Kali Linux Oficial en el Navegador",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--device=/dev/net/tun"
  ],
  "postStartCommand": "nohup bash -c 'vncserver -kill :1 2>/dev/null; vncserver :1 -geometry 1280x720 -depth 24 && websockify -D --web /usr/share/novnc/ 6080 localhost:5901' > /tmp/vnc.log 2>&1 &",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Kali Linux Escritorio",
      "visibility": "public",
      "onAutoForward": "openBrowser"
    }
  }
}
